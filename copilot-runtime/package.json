{
  "name": "yunhezhiyuan-aibackend-copilotruntime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24"},
  "scripts": {
    "postinstall": "node scripts/apply-security-patches.mjs",
    "patch:security": "node scripts/apply-security-patches.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/apply-security-patches.mjs --check && tsc -p tsconfig.build.json",
    "test": "node scripts/apply-security-patches.mjs --check && node tests/run.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@cfworker/json-schema": "4.1.6",
    "@copilotkit/runtime": "1.84.1",
    "express": "5.3.0",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
