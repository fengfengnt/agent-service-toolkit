# Compose 非秘密参数；本文件不包含运行密钥，不直接复制现有环境的 .env。
XIAOHE_RUNTIME_ENV_FILE=/secure/xiaohe/runtime.env
XIAOHE_POSTGRES_PASSWORD_FILE=/secure/xiaohe/postgres-password
XIAOHE_MINIO_ROOT_USER_FILE=/secure/xiaohe/minio-root-user
XIAOHE_MINIO_ROOT_PASSWORD_FILE=/secure/xiaohe/minio-root-password
XIAOHE_TLS_CERT_FILE=/secure/xiaohe/tls/cert.pem
XIAOHE_TLS_KEY_FILE=/secure/xiaohe/tls/key.pem
XIAOHE_PUBLIC_HOST=portal.example.invalid
XIAOHE_SYSTEM_ID=portal
XIAOHE_LISTEN_IP=127.0.0.1
XIAOHE_HTTPS_PORT=19443
