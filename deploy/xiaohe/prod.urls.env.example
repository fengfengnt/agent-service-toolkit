# 生产公开连接片段；模型/加密/业务凭据保留经核实的UAT来源。
DATABASE_TYPE=postgres
POSTGRES_HOST=aibackend-postgres
POSTGRES_PORT=5432
POSTGRES_DB=xiaohe
TOOLKIT_BASE_URL=http://aibackend-api:8080
XIAOHE_RECEPTION_BASE_URL=http://serverbackend:18082
# 受信应用 ID 和凭据仅放私有 runtime.env；AI 不再配置对象存储凭据。
SSO_XIAOHE_BRIDGE_ENABLED=false
# Origin与issuer在xiaohe.systems及会员身份表中核对迁移，不能靠虚构env代替。
# XIAOHE_TRUSTED_PROXY_CIDRS 需测量实际OpenResty转发peer后填精确/32。
